# Copia este archivo como .env y cambia los valores. El .env NO se sube al repositorio.

# Contraseña del usuario "sa" de SQL Server (mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolo)
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_123

# Clave para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET_KEY=cambia_esta_clave_jwt_de_al_menos_32_caracteres

# Clave para cifrar datos sensibles
ENCRYPTION_KEY=cambia_esta_clave_de_cifrado

# Puerto en tu PC para la API
API_PORT=5199
