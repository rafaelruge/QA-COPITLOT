# Copia este archivo como .env y cambia los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Base de datos (contenedor 2)
POSTGRES_USER=notas_user
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=notas_db

# Aplicación (contenedor 1)
# DB_HOST es el NOMBRE DEL SERVICIO en docker-compose.yml, no localhost.
DB_HOST=db
DB_PORT=5432
APP_PORT=3000
